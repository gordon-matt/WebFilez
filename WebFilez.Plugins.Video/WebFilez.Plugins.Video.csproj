<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>WebFilez.Plugins.Video</RootNamespace>
		<Description>Optional video thumbnails for WebFilez. Chain it with AddVideo(). Without this package, WebFilez thumbnails images only.</Description>
		<PackageTags>file-manager;video;thumbnails;ffmpeg;plugin;webfilez</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Services\WebFilez.Services.csproj" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Xabe.FFmpeg" />
		<PackageReference Include="Xabe.FFmpeg.Downloader" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WebFilez.Tests" />
	</ItemGroup>

</Project>
