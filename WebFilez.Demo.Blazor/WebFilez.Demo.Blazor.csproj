<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.AspNetCore\WebFilez.AspNetCore.csproj" />
		<ProjectReference Include="..\WebFilez.Components\WebFilez.Components.csproj" />
		<ProjectReference Include="..\WebFilez.Plugins.FileRobot\WebFilez.Plugins.FileRobot.csproj" />
		<ProjectReference Include="..\WebFilez.Plugins.Video\WebFilez.Plugins.Video.csproj" />
		<ProjectReference Include="..\WebFilez.Plugins.FortuneSheet\WebFilez.Plugins.FortuneSheet.csproj" />
		<ProjectReference Include="..\WebFilez.Plugins.SuperDoc\WebFilez.Plugins.SuperDoc.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AmazonS3\WebFilez.Storage.AmazonS3.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AzureBlob\WebFilez.Storage.AzureBlob.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AzureFiles\WebFilez.Storage.AzureFiles.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.GoogleCloud\WebFilez.Storage.GoogleCloud.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LogVue" />
		<PackageReference Include="SkiaSharp" />
		<!-- Same Linux native assets as WebFilez.Services: seeding images must not need fontconfig. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux">
			<ExcludeAssets>all</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>none</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
		<PackageReference Include="LogVue.Data.Sqlite" />
		<PackageReference Include="LogVue.Providers.Serilog" />
		<PackageReference Include="Serilog.AspNetCore" />
	</ItemGroup>

</Project>