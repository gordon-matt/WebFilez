<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.AspNetCore\WebFilez.AspNetCore.csproj" />
		<ProjectReference Include="..\WebFilez.Plugins.Video\WebFilez.Plugins.Video.csproj" />
		<ProjectReference Include="..\WebFilez.Components\WebFilez.Components.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AmazonS3\WebFilez.Storage.AmazonS3.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AzureBlob\WebFilez.Storage.AzureBlob.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.AzureFiles\WebFilez.Storage.AzureFiles.csproj" />
		<ProjectReference Include="..\WebFilez.Storage.GoogleCloud\WebFilez.Storage.GoogleCloud.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.TestHost" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux">
			<ExcludeAssets>all</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>none</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Ardalis.Result" />
		<Using Include="WebFilez" />
		<Using Include="WebFilez.Enums" />
		<Using Include="WebFilez.Models" />
		<Using Include="WebFilez.Services" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>