@inject NavigationManager Navigation
<aside class="wf-info" aria-label="@Text["info.details"]">
    <div class="wf-info-header">
        <strong>@Text["info.details"]</strong>
        <span class="wf-spacer"></span>
        <button type="button" class="wf-icon-button" aria-label="@Text["info.close"]" @onclick="OnClose">
            <Icon Name="x" />
        </button>
    </div>

    @if (SelectionCount > 1)
    {
        <div class="wf-info-body">
            <div class="wf-info-preview"><Icon Name="copy" Class="wf-info-icon" /></div>
            <p class="wf-info-name">@Text.Format("info.selected", Text.Plural("count.items", SelectionCount))</p>
            <dl class="wf-info-list">
                <dt>@Text["info.totalSize"]</dt>
                <dd>@Format.Size(SelectedBytes) <span class="wf-muted">@Text["info.filesOnly"]</span></dd>
            </dl>
        </div>
    }
    else if (Detail is null && SelectionCount == 0)
    {
        <div class="wf-info-body wf-muted">@Text["info.none"]</div>
    }
    else if (Detail is null)
    {
        <div class="wf-info-body wf-muted">@Text["info.loading"]</div>
    }
    else
    {
        <div class="wf-info-body">
            <div class="wf-info-preview">
                @if (Item is { HasThumbnail: true } item)
                {
                    <img class="wf-checkered" alt="" src="@Urls.Thumbnail(RootId, item, 512)" />
                }
                else
                {
                    <FileIcon Kind="Detail.Kind" Class="wf-info-icon" />
                }
            </div>
            <p class="wf-info-name" title="@Detail.Name">@Detail.Name</p>

            <dl class="wf-info-list">
                <dt>@Text["info.type"]</dt>
                <dd>@(Detail.IsDirectory ? Text["listing.folder"] : Detail.MimeType)</dd>

                <dt>@Text["info.size"]</dt>
                <dd>
                    @if (!Detail.IsDirectory)
                    {
                        @Format.Size(Detail.SizeBytes)
                    }
                    else if (size is not null)
                    {
                        @Format.Size(size.SizeBytes)
                        <span class="wf-muted"> · @Text.Plural("count.files", size.FileCount)</span>
                    }
                    else
                    {
                        <button type="button" class="wf-link-button" disabled="@isCalculating" @onclick="CalculateSizeAsync">
                            @(isCalculating ? Text["info.calculating"] : Text["info.calculate"])
                        </button>
                    }
                </dd>

                @if (Detail.Width is int width && Detail.Height is int height)
                {
                    <dt>@Text["info.dimensions"]</dt>
                    <dd>@width × @height px</dd>
                }

                <dt>@Text["info.modified"]</dt>
                <dd>@Format.Full(Detail.ModifiedAt)</dd>

                <dt>@Text["info.created"]</dt>
                <dd>@Format.Full(Detail.CreatedAt)</dd>

                <dt>@Text["info.location"]</dt>
                <dd class="wf-break">@Detail.Path</dd>

                @if (Detail.PublicUrl is not null)
                {
                    <dt>@Text["info.publicUrl"]</dt>
                    <dd class="wf-row">
                        <a class="wf-break" href="@Urls.Public(Detail.PublicUrl)" target="_blank" rel="noopener">@Detail.PublicUrl</a>
                        <button type="button" class="wf-icon-button wf-icon-button-small" title="@Text["info.copyUrl"]" @onclick="CopyUrlAsync">
                            <Icon Name="copy" />
                        </button>
                    </dd>
                }

                <dt>@Text["info.access"]</dt>
                <dd>@DescribePermissions(Detail.Permissions)</dd>
            </dl>
        </div>
    }
</aside>

@code {
    private DirectorySizeDto? size;
    private bool isCalculating;
    private string? sizeFor;

    [Parameter] public FileDetailDto? Detail { get; set; }

    /// <summary>The listed item, when the details are for one, so a thumbnail can be shown.</summary>
    [Parameter] public FileSystemItemDto? Item { get; set; }

    [Parameter] public int SelectionCount { get; set; }

    [Parameter] public long SelectedBytes { get; set; }

    [Parameter, EditorRequired] public string RootId { get; set; } = string.Empty;

    [Parameter, EditorRequired] public WebFilezUrls Urls { get; set; } = default!;

    [Parameter, EditorRequired] public IFileManagerService Service { get; set; } = default!;

    [Parameter, EditorRequired] public WebFilezInterop Interop { get; set; } = default!;

    [Parameter] public ToastService? Toasts { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [CascadingParameter] private WebFilezText Text { get; set; } = WebFilezText.English;

    protected override void OnParametersSet()
    {
        string? key = Detail is null ? null : $"{RootId}|{Detail.Path}";
        if (key != sizeFor)
        {
            size = null;
            sizeFor = key;
        }
    }

    private async Task CalculateSizeAsync()
    {
        if (Detail is null)
        {
            return;
        }

        isCalculating = true;
        var result = await Service.GetDirectorySizeAsync(RootId, Detail.Path);
        isCalculating = false;

        if (result.IsSuccess)
        {
            size = result.Value;
        }
        else
        {
            Toasts?.ShowFailure(result);
        }
    }

    private async Task CopyUrlAsync()
    {
        if (Detail?.PublicUrl is { } url && await Interop.CopyTextAsync(new Uri(new Uri(Navigation.BaseUri), Urls.Public(url)).ToString()))
        {
            Toasts?.Success(Text["toast.copiedUrl"]);
        }
    }

    private string DescribePermissions(FilePermission permissions)
    {
        if (permissions.Has(FilePermission.Full))
        {
            return Text["info.full"];
        }

        if (permissions.Has(FilePermission.Contributor))
        {
            return Text["info.contributor"];
        }

        return permissions.Has(FilePermission.ReadOnly) ? Text["info.readOnly"] : Text["info.limited"];
    }
}
