@implements IAsyncDisposable

<CascadingValue Value="Text" IsFixed="false">
<div class="wf-root @Class" lang="@Text.Language" dir="@(Text.IsRightToLeft ? "rtl" : "ltr")" data-theme="@Theme" tabindex="-1" @ref="rootElement" @attributes="AdditionalAttributes"
     data-wf-root="@rootId" data-wf-path="@CurrentPath" data-wf-public-url="@CurrentPublicUrl">
    <div class="wf-shell @(IsPicker ? "wf-picker" : null)" style="height: @Height">

        @* ------------------------------------------------------------- toolbar *@
        <div class="wf-toolbar">
            <div class="wf-toolbar-row">
                @if (ShowTree)
                {
                    <button type="button" class="wf-icon-button" title="@(isTreeOpen ? Text["toolbar.hideFolders"] : Text["toolbar.showFolders"])"
                            aria-pressed="@(isTreeOpen ? "true" : "false")" @onclick="() => isTreeOpen = !isTreeOpen">
                        <Icon Name="panel-left" />
                    </button>
                }
                <button type="button" class="wf-icon-button" title="@Text["toolbar.up"]"
                        disabled="@IsAtFloor" @onclick="GoUpAsync">
                    <Icon Name="arrow-up" />
                </button>

                @if (listing is not null)
                {
                    <Breadcrumbs Items="VisibleBreadcrumbs" OnNavigate="p => NavigateAsync(rootId!, p)" OnDropOnto="e => DropOntoAsync(rootId!, e.Path, e.Args)" />
                }

                <span class="wf-spacer"></span>

                <label class="wf-search">
                    <Icon Name="search" />
                    <input type="search" placeholder="@(searchScope == SearchScope.Folder ? Text["toolbar.filterPlaceholder"] : Text["toolbar.searchPlaceholder"])"
                           aria-label="@(searchScope == SearchScope.Folder ? Text["toolbar.filterLabel"] : Text["toolbar.searchLabel"])"
                           @bind="filter" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
                </label>
                <select class="wf-input wf-scope" aria-label="@Text["toolbar.scopeLabel"]" value="@searchScope" @onchange="OnScopeChangedAsync">
                    <option value="@SearchScope.Folder">@Text["scope.folder"]</option>
                    <option value="@SearchScope.Root">@Text["scope.root"]</option>
                    @if (!IsConfined)
                    {
                        <option value="@SearchScope.All">@Text["scope.all"]</option>
                    }
                </select>
            </div>

            <div class="wf-toolbar-row">
                @if (Can(FilePermission.Create))
                {
                    <div class="wf-dropdown">
                        <button type="button" class="wf-button wf-button-primary" aria-haspopup="menu"
                                aria-expanded="@(openMenu == "new" ? "true" : "false")" @onclick='() => ToggleMenu("new")'>
                            <Icon Name="plus" /> <span class="wf-hide-narrow">@Text["toolbar.new"]</span>
                        </button>
                        @if (openMenu == "new")
                        {
                            <div class="wf-menu-layer" @onclick="() => openMenu = null"></div>
                            <div class="wf-menu wf-menu-dropdown" role="menu">
                                <button type="button" role="menuitem" class="wf-menu-item" @onclick="() => RunMenuAsync(CreateFolderAsync)">
                                    <Icon Name="folder-plus" /> <span>@Text["toolbar.folder"]</span>
                                </button>
                                <button type="button" role="menuitem" class="wf-menu-item" @onclick="() => RunMenuAsync(CreateTextFileAsync)">
                                    <Icon Name="file-plus" /> <span>@Text["toolbar.textFile"]</span>
                                </button>
                                <div class="wf-menu-separator" role="separator"></div>
                                <button type="button" role="menuitem" class="wf-menu-item" @onclick="() => RunMenuAsync(() => PickFilesAsync(false))">
                                    <Icon Name="upload" /> <span>@Text["toolbar.uploadFiles"]</span>
                                </button>
                                <button type="button" role="menuitem" class="wf-menu-item" @onclick="() => RunMenuAsync(() => PickFilesAsync(true))">
                                    <Icon Name="folder-up" /> <span>@Text["toolbar.uploadFolder"]</span>
                                </button>
                            </div>
                        }
                    </div>

                    <button type="button" class="wf-button" title="@Text["toolbar.uploadFiles"]" @onclick="() => PickFilesAsync(false)">
                        <Icon Name="upload" /> <span class="wf-hide-narrow">@Text["toolbar.upload"]</span>
                    </button>
                }

                @if (selection.Count > 0)
                {
                    @if (Can(FilePermission.Create))
                    {
                        <span class="wf-toolbar-divider"></span>
                    }
                    @if (CanOnSelection(FilePermission.Download))
                    {
                        <button type="button" class="wf-icon-button" title="@Text["toolbar.download"]" @onclick="DownloadSelectionAsync"><Icon Name="download" /></button>
                    }
                    @if (CanOnSelection(FilePermission.Read) && Can(FilePermission.Create))
                    {
                        <button type="button" class="wf-icon-button" title="@Text["toolbar.copy"]" @onclick="() => SetClipboard(isCut: false)"><Icon Name="copy" /></button>
                    }
                    @if (CanOnSelection(FilePermission.Move | FilePermission.Delete))
                    {
                        <button type="button" class="wf-icon-button" title="@Text["toolbar.cut"]" @onclick="() => SetClipboard(isCut: true)"><Icon Name="scissors" /></button>
                    }
                    @if (selection.Count == 1 && CanOnSelection(FilePermission.Rename))
                    {
                        <button type="button" class="wf-icon-button" title="@Text["toolbar.rename"]" @onclick="RenameAsync"><Icon Name="pencil" /></button>
                    }
                    @if (CanOnSelection(FilePermission.Delete))
                    {
                        <button type="button" class="wf-icon-button wf-icon-button-danger" title="@Text["toolbar.delete"]" @onclick="DeleteAsync"><Icon Name="trash" /></button>
                    }
                }

                @if (clipboard is not null && Can(FilePermission.Create))
                {
                    <span class="wf-toolbar-divider"></span>
                    <button type="button" class="wf-button" title="@Text["toolbar.paste"]" @onclick="() => PasteAsync()">
                        <Icon Name="clipboard" /> <span class="wf-hide-narrow">@Text.Format("menu.paste", clipboard.Paths.Count)</span>
                    </button>
                    <button type="button" class="wf-icon-button" title="@Text["toolbar.clearClipboard"]" @onclick="() => clipboard = null"><Icon Name="x" /></button>
                }

                <span class="wf-spacer"></span>

                @if (!kindLocked)
                {
                    <div class="wf-segmented wf-kind-filter" role="group" aria-label="@Text["toolbar.show"]">
                        @foreach (var option in KindFilters)
                        {
                            <button type="button" class="@(kindFilter == option.Filter ? "wf-active" : null)" title="@option.Label"
                                    aria-pressed="@(kindFilter == option.Filter ? "true" : "false")" @onclick="() => SetKindFilterAsync(option.Filter)">
                                <Icon Name="@option.Icon" /> <span class="wf-hide-narrow">@option.Label</span>
                            </button>
                        }
                    </div>
                }

                <div class="wf-segmented" role="group" aria-label="@Text["toolbar.view"]">
                    @foreach (var option in ViewModes)
                    {
                        <button type="button" class="@(viewMode == option.Mode ? "wf-active" : null)" title="@option.Label"
                                aria-pressed="@(viewMode == option.Mode ? "true" : "false")" @onclick="() => SetViewModeAsync(option.Mode)">
                            <Icon Name="@option.Icon" />
                        </button>
                    }
                </div>

                <div class="wf-dropdown">
                    <button type="button" class="wf-icon-button" title="@Text["toolbar.sortOptions"]" aria-haspopup="menu"
                            aria-expanded="@(openMenu == "options" ? "true" : "false")" @onclick='() => ToggleMenu("options")'>
                        <Icon Name="sliders" />
                    </button>
                    @if (openMenu == "options")
                    {
                        <div class="wf-menu-layer" @onclick="() => openMenu = null"></div>
                        <div class="wf-menu wf-menu-dropdown wf-menu-end" role="menu">
                            <div class="wf-menu-heading">@Text["toolbar.sortBy"]</div>
                            @foreach (var field in Enum.GetValues<ListingSortField>())
                            {
                                <button type="button" role="menuitemradio" aria-checked="@(sortBy == field ? "true" : "false")"
                                        class="wf-menu-item" @onclick="() => RunMenuAsync(() => SortByAsync(field))">
                                    <Icon Name="@(sortBy != field ? "x" : descending ? "chevron-down" : "arrow-up")" Class="@(sortBy != field ? "wf-invisible" : null)" />
                                    <span>@Text["sort." + field.ToString().ToLowerInvariant()]</span>
                                </button>
                            }
                            <div class="wf-menu-separator" role="separator"></div>
                            @if (CanShowHidden)
                            {
                                <button type="button" role="menuitemcheckbox" aria-checked="@(showHidden ? "true" : "false")"
                                        class="wf-menu-item" @onclick="() => RunMenuAsync(ToggleHiddenAsync)">
                                    <Icon Name="check" Class="@(showHidden ? null : "wf-invisible")" /> <span>@Text["toolbar.showHidden"]</span>
                                </button>
                            }
                            <button type="button" role="menuitemcheckbox" aria-checked="@(isInfoOpen ? "true" : "false")"
                                    class="wf-menu-item" @onclick="() => RunMenuAsync(ToggleInfoAsync)">
                                <Icon Name="check" Class="@(isInfoOpen ? null : "wf-invisible")" /> <span>@Text["toolbar.detailsPanel"]</span>
                            </button>
                            <div class="wf-menu-separator" role="separator"></div>
                            <div class="wf-menu-heading">@Text["toolbar.language"]</div>
                            @foreach (var language in Locales.Languages)
                            {
                                bool currentLanguage = string.Equals(text.Language, language.Tag, StringComparison.OrdinalIgnoreCase);
                                <button type="button" role="menuitemradio" aria-checked="@(currentLanguage ? "true" : "false")"
                                        class="wf-menu-item" @onclick="() => RunMenuAsync(() => SetLanguageAsync(language.Tag))">
                                    <Icon Name="check" Class="@(currentLanguage ? null : "wf-invisible")" />
                                    <span dir="@(language.IsRightToLeft ? "rtl" : "ltr")">@language.NativeName</span>
                                </button>
                            }
                            <div class="wf-menu-separator" role="separator"></div>
                            <button type="button" role="menuitem" class="wf-menu-item" @onclick="() => RunMenuAsync(RefreshAfterChangeAsync)">
                                <Icon Name="refresh" /> <span>@Text["toolbar.refresh"]</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ------------------------------------------------------------- body *@
        <div class="wf-body">
            @if (ShowTree && isTreeOpen && roots.Count > 0)
            {
                <div class="wf-tree-pane">
                    <FolderTree @ref="tree" Service="Service" Roots="roots" RootId="@rootId" CurrentPath="@CurrentPath" StartPath="@Floor"
                                OnNavigate="e => NavigateAsync(e.RootId, e.Path)"
                                OnDropOnto="e => DropOntoAsync(e.RootId, e.Path, e.Args)" />
                </div>
            }

            <div class="wf-listing" tabindex="0" @ref="listingElement" data-drop-label="@Text["listing.dropOverlay"]"
                 @onclick="ClearSelection"
                 @oncontextmenu="ShowBackgroundMenu" @oncontextmenu:preventDefault="true">
                @if (ShowingSearch)
                {
                    <div class="wf-search-banner" @onclick:stopPropagation="true">
                        @if (searchError is not null)
                        {
                            <span>@searchError</span>
                            <button type="button" class="wf-button" @onclick="RunSearchAsync">@Text["listing.tryAgain"]</button>
                        }
                        else if (searchResults is null)
                        {
                            <span class="wf-spinner" role="status" aria-label="@Text["listing.loading"]"></span>
                        }
                        else
                        {
                            <span>@Text.Plural("count.items", searchResults.Hits.Count)</span>
                            @if (searchResults.Truncated)
                            {
                                <span class="wf-muted">@Text["listing.truncated"]</span>
                            }
                            <button type="button" class="wf-button" @onclick="ClearSearchAsync">@Text["listing.clearSearch"]</button>
                        }
                    </div>
                }
                @if (loadError is not null && !ShowingSearch)
                {
                    <div class="wf-empty">
                        <Icon Name="alert" Class="wf-empty-icon" />
                        <p>@loadError</p>
                        <button type="button" class="wf-button" @onclick="LoadAsync" @onclick:stopPropagation="true">@Text["listing.tryAgain"]</button>
                    </div>
                }
                else if (listing is null && !ShowingSearch)
                {
                    <div class="wf-empty"><span class="wf-spinner" role="status" aria-label="@Text["listing.loading"]"></span></div>
                }
                else if (ShowingSearch && searchResults is null && searchError is null)
                {
                    <div class="wf-empty"><span class="wf-spinner" role="status" aria-label="@Text["listing.loading"]"></span></div>
                }
                else
                {
                    <FileListing Entries="Rows()"
                                 Urls="urls"
                                 ViewMode="viewMode"
                                 SortBy="sortBy"
                                 Descending="descending"
                                 SelectedKeys="selection"
                                 ActiveKey="activeKey"
                                 CutPaths="CutPaths"
                                 EmptyText="@(ShowingSearch ? Text["listing.noResults"] : !string.IsNullOrWhiteSpace(filter) || kindFilter != KindFilter.All ? Text["listing.noMatches"] : Text["listing.empty"])"
                                 ShowDropHint="@(!ShowingSearch && Can(FilePermission.Create) && string.IsNullOrWhiteSpace(filter) && kindFilter == KindFilter.All)"
                                 DropHint="@Text["listing.dropHint"]"
                                 ShowCheckboxes="@(SelectionMode != Constants.SelectionModes.Single)"
                                 ShowLocation="ShowingSearch"
                                 SelectAllLabel="@Text["listing.selectAll"]"
                                 NameHeader="@Text["listing.name"]"
                                 SizeHeader="@Text["listing.size"]"
                                 ModifiedHeader="@Text["listing.modified"]"
                                 LocationHeader="@Text["listing.location"]"
                                 FolderLabel="@Text["listing.folder"]"
                                 IsSelectable="IsSelectable"
                                 CanDrag="CanDrag"
                                 OnItemClick="OnItemClickAsync"
                                 OnItemActivate="ActivateAsync"
                                 OnToggleSelect="ToggleSelectAsync"
                                 OnItemContextMenu="ShowItemMenuAsync"
                                 OnSelectAll="SelectAllAsync"
                                 OnSort="SortByAsync"
                                 OnDragStart="OnDragStart"
                                 OnDragEnd="() => dragPaths = null"
                                 OnDropOnto="e => DropOntoAsync(e.RootId, e.Path, e.Args)" />

                    @if (!ShowingSearch && listing is not null && listing.TotalCount > listing.Items.Count)
                    {
                        <div class="wf-more">
                            <button type="button" class="wf-button" @onclick="LoadMoreAsync" @onclick:stopPropagation="true">
                                @Text.Format("listing.showMore", listing.Items.Count.ToString("N0", Text.Culture), listing.TotalCount.ToString("N0", Text.Culture))
                            </button>
                        </div>
                    }
                }
            </div>

            @if (isInfoOpen && listing is not null)
            {
                <InfoPanel Detail="detail"
                           Item="DetailItem"
                           SelectionCount="selection.Count"
                           SelectedBytes="SelectedBytes"
                           RootId="@DetailRootId"
                           Urls="urls"
                           Service="Service"
                           Interop="interop"
                           Toasts="toasts"
                           OnClose="() => isInfoOpen = false" />
            }
        </div>

        @* ------------------------------------------------------------- status bar *@
        <div class="wf-status">
            @if (listing is not null)
            {
                <span>@Text.Plural("count.items", ShowingSearch && searchResults is not null ? searchResults.Hits.Count : listing.TotalCount)</span>
                @if (!ShowingSearch)
                {
                    <span class="wf-muted wf-hide-narrow">@Format.Size(listing.TotalSizeBytes)</span>
                }
                @if (selection.Count > 0)
                {
                    <span class="wf-muted">@Text.Format("status.selected", selection.Count)</span>
                }
                @if (!Can(FilePermission.Create | FilePermission.Modify | FilePermission.Delete))
                {
                    <span class="wf-badge"><Icon Name="lock" /> @Text["status.readOnly"]</span>
                }
            }
            <span class="wf-spacer"></span>
            @if (IsPicker)
            {
                <span class="wf-muted wf-small wf-hide-narrow">@PickerHint</span>
                <button type="button" class="wf-button wf-button-primary" disabled="@(!CanConfirmSelection)" @onclick="ConfirmSelectionAsync">
                    <Icon Name="check-circle" /> @SelectLabel
                </button>
            }
        </div>
    </div>

    @* ------------------------------------------------------------- overlays *@
    <ContextMenu IsVisible="contextMenu is not null"
                 X="menuX" Y="menuY"
                 Entries="@(contextMenu ?? [])"
                 Interop="interop"
                 OnClose="() => contextMenu = null"
                 OnSelect="OnContextActionAsync" />

    <PreviewDialog Current="previewItem"
                   Items="PreviewableItems"
                   RootId="@(previewRoot ?? rootId ?? string.Empty)"
                   Urls="urls"
                   Service="Service"
                   Interop="interop"
                   OnNavigate="item => previewItem = item"
                   OnDownload="item => DownloadAsync(previewRoot ?? rootId ?? string.Empty, [item])"
                   OnClose="ClosePreviewAsync" />

    <TextEditorDialog @ref="editor"
                      Service="Service"
                      Interop="interop"
                      Toasts="toasts"
                      ConfirmDiscard="ConfirmDiscardAsync"
                      OnSaved="_ => RefreshAfterChangeAsync()" />

    <UploadTray Uploads="uploads" OnCancel="CancelUploadAsync" OnDismiss="() => uploads.Clear()" />

    <PromptDialog @ref="prompt" Interop="interop" />
    <ConfirmDialog @ref="confirm" Interop="interop" />
    <Toaster Service="toasts" />
</div>
</CascadingValue>
