<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>WebFilez.Components</RootNamespace>
		<Description>The WebFilez file manager and file picker component, for Blazor Server, Blazor WebAssembly and MVC.</Description>
		<PackageTags>file-manager;file-browser;file-picker;blazor;razor-components;aspnetcore-mvc;webfilez</PackageTags>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Core\WebFilez.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Locales\*.json" LogicalName="WebFilez.Components.Locales.%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
