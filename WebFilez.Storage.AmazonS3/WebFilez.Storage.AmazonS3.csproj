<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Amazon S3 provider for WebFilez. Chain it with AddAmazonS3().</Description>
		<PackageTags>file-manager;storage-provider;amazon-s3;aws;s3;webfilez</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Services\WebFilez.Services.csproj" />
		<PackageReference Include="AWSSDK.S3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WebFilez.Tests" />
	</ItemGroup>

</Project>
