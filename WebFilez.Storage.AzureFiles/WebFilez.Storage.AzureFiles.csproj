<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Azure Files provider for WebFilez. Chain it with AddAzureFiles().</Description>
		<PackageTags>file-manager;storage-provider;azure;azure-files;file-share;webfilez</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Services\WebFilez.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Files.Shares" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WebFilez.Tests" />
	</ItemGroup>

</Project>