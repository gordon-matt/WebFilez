<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Google Cloud Storage provider for WebFilez. Register it with AddWebFilezGoogleCloud().</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Services\WebFilez.Services.csproj" />
		<PackageReference Include="Google.Cloud.Storage.V1" Version="5.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WebFilez.Tests" />
	</ItemGroup>

</Project>
