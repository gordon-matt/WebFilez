{
  "WebFilez": {
    "Roots": [
      {
        "Id": "files",
        "Name": "Files",
        "Path": "App_Data/files"
      },
      {
        "Id": "media",
        "Name": "Media",
        "Path": "App_Data/media",
        "PublicUrl": "/media"
      },
      {
        "Id": "handbook",
        "Name": "Handbook",
        "Path": "App_Data/handbook",
        "IsReadOnly": true
      }//,

      // Azure Blob Storage. The container must already exist. Path is the blob prefix; Settings.Prefix overrides it.
      // For Azurite: docker run -d --name azurite --restart unless-stopped -p 10000:10000 -p 10001:10001 -p 10002:10002 mcr.microsoft.com/azure-storage/azurite
      // Then set ConnectionString to "UseDevelopmentStorage=true". Create the blob container before listing it,
      // and allow anonymous blob read. Azurite is HTTP-only, so PublicBaseUrl uses the demo's /azurite proxy.
      // {
      //   "Id": "uploads",
      //   "Name": "Uploads",
      //   "Provider": "azure-blob",
      //   "Path": "campaigns",
      //   "PublicBaseUrl": "/azurite/files",
      //   "Settings": {
      //     "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net",
      //     "Container": "files"
      //   }
      // },

      // Azure Files. The share and the Path directory must already exist. Azurite does not emulate file shares.
      // {
      //   "Id": "shared",
      //   "Name": "Shared",
      //   "Provider": "azure-file",
      //   "Path": "campaigns",
      //   "Settings": {
      //     "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net",
      //     "Share": "files"
      //   }
      // },

      // Amazon S3. The bucket must already exist. Any non-empty access key is accepted.
      // localstack/localstack:latest requires LOCALSTACK_AUTH_TOKEN. The last community image does not:
      //   docker run -d --name localstack -p 4566:4566 -e SERVICES=s3 localstack/localstack:4.14.0
      // {
      //   "Id": "photos",
      //   "Name": "Photos",
      //   "Provider": "amazon-s3",
      //   "Path": "campaigns",
      //   "Settings": {
      //     "AccessKey": "test",
      //     "SecretKey": "test",
      //     "Region": "us-east-1",
      //     "Bucket": "files",
      //     "ServiceUrl": "http://127.0.0.1:4566"
      //   }
      // },

      // Google Cloud Storage. The bucket must already exist.
      // Use CredentialJson instead of CredentialFile to pass the service-account key inline.
      // For fake-gcs-server, start it with -scheme http (the image defaults to HTTPS) and set
      // ServiceUrl to "http://127.0.0.1:4443". Leave the credentials out.
      // fake-gcs-server does not serve /{bucket}/{object}, and it is HTTP-only. PublicBaseUrl uses
      // the demo's /gcs proxy (the bucket name is part of that base).
      // {
      //   "Id": "archive",
      //   "Name": "Archive",
      //   "Provider": "google-cloud",
      //   "Path": "campaigns",
      //   "PublicBaseUrl": "/gcs/files",
      //   "Settings": {
      //     "Bucket": "files",
      //     "CredentialFile": "C:\\keys\\storage.json"
      //   }
      // }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "LogVue": {
    "Title": "WebFilez MVC",
    "RetentionDays": 30
  },
  "AllowedHosts": "*"
}
