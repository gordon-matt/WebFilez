{
  "WebFilez": {
    "Roots": [
      {
        "Id": "files",
        "Name": "Files",
        "Path": "App_Data/files"
      },
      {
        "Id": "media",
        "Name": "Media",
        "Path": "App_Data/media",
        "PublicUrl": "/media"
      },
      {
        "Id": "handbook",
        "Name": "Handbook",
        "Path": "App_Data/handbook",
        "IsReadOnly": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
