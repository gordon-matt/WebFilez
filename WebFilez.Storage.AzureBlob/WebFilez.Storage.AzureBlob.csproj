<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Azure Blob Storage provider for WebFilez. Chain it with AddAzureBlob().</Description>
		<PackageTags>file-manager;storage-provider;azure;azure-blob-storage;blob;webfilez</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebFilez.Services\WebFilez.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WebFilez.Tests" />
	</ItemGroup>

</Project>